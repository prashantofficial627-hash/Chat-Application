{
  "expo": {
    "name": "Chat Application",
    "slug": "chat-application",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Chat Application to access your camera to take and send photos to your friends.",
        "NSPhotoLibraryUsageDescription": "Allow Chat Application to access your photos to share them with your friends."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.prashant27.chatapplication",
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Chat Application to access your camera",
          "microphonePermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "80474927-efd3-4ffb-962d-2a7c34c47b3d"
      }
    }
  }
}
